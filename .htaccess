Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Canonicalize www -> non-www. Must run here, before the internal forward
    # to public/ below — once that forward rewrites the URI, REQUEST_URI
    # includes the /public prefix and a redirect rule further down the chain
    # would send external requests to https://displaynex.com/public/...
    RewriteCond %{HTTP_HOST} ^www\.displaynex\.com$ [NC]
    RewriteRule ^ https://displaynex.com%{REQUEST_URI} [L,R=301]

    # Block direct web access to application source directories
    RewriteRule ^(app|config|storage|install|signagecloud_clean)(/.*)?$ - [F,L]

    # Block direct access to dot-files (.env, .htaccess, .git, etc.)
    RewriteRule (^|/)\. - [F,L]

    # Forward all requests into public/ — the !^/public condition prevents
    # Apache re-processing this rule on the already-rewritten URI (loop prevention)
    RewriteCond %{REQUEST_URI} !^/public
    RewriteRule ^(.*)$ public/$1 [L,QSA]
</IfModule>
