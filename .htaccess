Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Block direct web access to application source directories
    RewriteRule ^(app|config|storage|install|signagecloud_clean)(/.*)?$ - [F,L]

    # Block direct access to dot-files (.env, .htaccess, .git, etc.)
    RewriteRule (^|/)\. - [F,L]

    # Serve static files that exist inside public/ (CSS, images, uploads, robots.txt, etc.)
    RewriteCond %{DOCUMENT_ROOT}/public%{REQUEST_URI} -f
    RewriteRule ^(.*)$ public/$1 [L]

    # Everything else goes to the front controller
    RewriteRule ^ public/index.php [L]
</IfModule>
