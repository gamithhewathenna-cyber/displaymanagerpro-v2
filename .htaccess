Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Block direct web access to application source directories
    RewriteRule ^(app|config|storage|install|signagecloud_clean)(/.*)?$ - [F,L]

    # Block direct access to dot-files (.env, .htaccess, .git, etc.)
    RewriteRule (^|/)\. - [F,L]

    # Forward all requests into public/ — the !^/public condition prevents
    # Apache re-processing this rule on the already-rewritten URI (loop prevention)
    RewriteCond %{REQUEST_URI} !^/public
    RewriteRule ^(.*)$ public/$1 [L,QSA]
</IfModule>
