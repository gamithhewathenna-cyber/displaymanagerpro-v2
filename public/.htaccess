Options -Indexes
RewriteEngine On
RewriteBase /

# www -> non-www canonicalization now lives in the root .htaccess, before the
# internal forward into public/ (see comment there for why it must run first).

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [L]
